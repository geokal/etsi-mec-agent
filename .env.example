# Qdrant vector database configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_INDEX=etsi_mec_specs

# Remote Qdrant (e.g. Qdrant Cloud free tier). QDRANT_URL wins over HOST/PORT when set;
# put the real values only in your untracked .env copy, never in this example file.
QDRANT_URL=
QDRANT_API_KEY=

# Answer LLM — any OpenAI-compatible endpoint. Defaults below = the OpenRouter free router.
# LLM_API_KEY falls back to OPENROUTER_API_KEY when empty.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free
OPENROUTER_API_KEY=

# Optional password gate for the Streamlit showcase (app.py). Unset = open; on a public
# deploy prefer the platform's own auth (e.g. the HF Space login gate).
APP_PASSWORD=

# FastEmbed model configuration
# Default: BAAI/bge-small-en-v1.5 (384 dimensions, fast & accurate ONNX CPU runtime)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
