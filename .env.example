# Qdrant vector database configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_INDEX=etsi_mec_specs

# Remote Qdrant (e.g. Qdrant Cloud free tier). QDRANT_URL wins over HOST/PORT when set;
# put the real values only in your untracked .env copy, never in this example file.
QDRANT_URL=
QDRANT_API_KEY=

# Answer LLM — any OpenAI-compatible endpoint. Defaults below = the OpenRouter free router.
# LLM_API_KEY falls back to OPENROUTER_API_KEY when empty.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free
OPENROUTER_API_KEY=

# Optional password gate for the Streamlit showcase (app.py). Unset = open; on a public
# deploy prefer the platform's own auth (e.g. the HF Space login gate).
APP_PASSWORD=

# Embedding runtime + model configuration. The ids below name the vector space, so changing one
# without re-ingesting yields a collection whose vectors no longer match the queries — the identity
# guard in store.verify_collection_identity aborts that instead of returning ranked noise.
#
# EMBEDDING_MODE=local (default) embeds on this machine with FastEmbed ONNX:
#   DENSE_MODEL   default BAAI/bge-small-en-v1.5 (384-d, fast & accurate ONNX CPU runtime)
#   COLBERT_MODEL default colbert-ir/colbertv2.0 (128-d late-interaction re-rank)
#
# EMBEDDING_MODE=cloud sends the text to Qdrant Cloud Inference and stores the vectors it returns;
# nothing loads ONNX here. It requires QDRANT_URL + QDRANT_API_KEY above (a local Docker Qdrant has
# no inference service), and DENSE_MODEL / COLBERT_MODEL must then be ids your cluster offers — the
# free ones are listed in the Inference tab of the cluster's page in the Qdrant Cloud console. Set
# DENSE_DIM / COLBERT_DIM to what those models emit (the console lists the dimensions too) and
# ingest into a fresh collection: cloud vectors are a different space from the local corpus.
# Sparse stays client-side crc32 term frequency in both modes.
EMBEDDING_MODE=local
DENSE_MODEL=BAAI/bge-small-en-v1.5
DENSE_DIM=384
COLBERT_MODEL=colbert-ir/colbertv2.0
COLBERT_DIM=128
